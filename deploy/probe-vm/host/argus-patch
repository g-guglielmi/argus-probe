# argus-patch - Patch now on a probe VM (Argus DESIGN 14c): the pending security updates, right away,
# the same unattended-upgrade run that applies them by itself every day. Argus hands the request to
# the probe at its check-in, the proxy container drops patch-request.json in the data folder, and
# argus-patch.path starts this. The request carries nothing but its time.
set -u
DIR="${ARGUS_STATE_DIR:-/docker/argus-probe}"
REQ="$DIR/patch-request.json"
RES="$DIR/patch-result.json"
[ -f "$REQ" ] || exit 0
rm -f "$REQ"
why="request"
result() {
  umask 022
  tmp="$(mktemp "$DIR/.patch-result.XXXXXX")"
  printf '{"state":"%s","at":%d,"why":"%s","detail":"%s"}\n' "$1" "$(date +%s)" "$why" "$2" > "$tmp"
  mv -f "$tmp" "$RES"; chmod 0644 "$RES"
}
logger -t argus-patch "applying the pending security updates on request from Argus"
DEBIAN_FRONTEND=noninteractive unattended-upgrade -v 2>&1 | logger -t argus-patch
uu=${PIPESTATUS[0]}
# A DietPi probe host (a Raspberry Pi or a mini PC) also takes a waiting DietPi release: DietPi's own
# daily check leaves its version in /run/dietpi/.update_available, "dietpi-update 1" applies it
# without questions.
DP="${ARGUS_DIETPI_UPDATE:-/boot/dietpi/dietpi-update}"
DPFLAG="${ARGUS_DIETPI_FLAG:-/run/dietpi/.update_available}"
dp=0; dpv=""
if [ -x "$DP" ] && [ -s "$DPFLAG" ]; then
  dpv="$(head -c 32 "$DPFLAG" | tr -cd '0-9.')"
  logger -t argus-patch "applying DietPi $dpv"
  "$DP" 1 2>&1 | logger -t argus-patch
  dp=${PIPESTATUS[0]}
fi
if [ "$uu" -ne 0 ]; then
  result failed "unattended-upgrade reported a problem: journalctl -t argus-patch on the probe host has the details"
elif [ "$dp" -ne 0 ]; then
  result failed "the security updates were applied, DietPi $dpv was not: journalctl -t argus-patch on the probe host has the details"
elif [ -n "$dpv" ]; then
  result done "security updates and DietPi $dpv applied"
else
  result done "security updates applied"
fi
ARGUS_STATE_DIR="$DIR" "${ARGUS_OS_REPORT:-/usr/local/sbin/argus-os-report}" || true
