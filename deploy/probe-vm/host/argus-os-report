"""Report this probe VM's OS patch status to Argus (DESIGN 14c) and keep a copy for the console.

The VM patches its own Debian OS locally via unattended-upgrades (security suite only) and reboots
itself in a weekly ~03:00 window. This reporter only reports: it posts the pending security-update
count and the reboot-required flag to Argus, so the fleet view shows which sites carry CVEs or need
a reboot, and writes the same as os-status.json into the probe's data folder, where the console menu
reads it. Run hourly by argus-os-report.timer, after the host tools were applied, and as soon as the
probe enrolls (argus-os-report.path watches proxy.env), so the first report doesn't wait an hour.

Standard library only. Authenticated by the same long-lived probe token the enrollment wrote to
proxy.env, so until the VM has enrolled there is nothing to post (the local file is still written).
"""
import json
import os
import re
import subprocess
import time
import urllib.request

STATE_DIR = os.environ.get("ARGUS_STATE_DIR", "/docker/argus-probe")
META = os.path.join(STATE_DIR, "enroll", "proxy.env")   # written by the probe container at enrollment
STATUS_FILE = os.path.join(STATE_DIR, "os-status.json")


def read_kv(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return out


def sec_updates():
    """Count pending SECURITY updates (best-effort). A simulated upgrade lists the packages apt would
    install; the ones whose source archive is a *-security suite are the security updates. -1 = unknown."""
    try:
        out = subprocess.run(
            ["apt-get", "-s", "-o", "Debug::NoLocking=true", "upgrade"],
            capture_output=True, text=True, timeout=90,
        ).stdout
    except Exception:
        return -1
    n = 0
    for line in out.splitlines():
        if line.startswith("Inst") and re.search(r"[Ss]ecurity", line):
            n += 1
    return n


def os_name(release="/etc/os-release", debian="/etc/debian_version"):
    """The OS as Argus shows it: Debian with its point release ("Debian 13.7", from DEBIAN_VERSION_FULL,
    or /etc/debian_version before Debian 13 added it), anything else by its PRETTY_NAME. "" if unreadable."""
    kv = {k: v.strip('"').strip("'") for k, v in read_kv(release).items()}
    if kv.get("ID") == "debian":
        v = kv.get("DEBIAN_VERSION_FULL", "")
        if not v:
            try:
                with open(debian, encoding="utf-8") as fh:
                    v = fh.read().strip()
            except OSError:
                pass
        if re.fullmatch(r"[0-9][0-9.]*", v):  # testing and sid read "forky/sid": those keep the pretty name
            return "Debian " + v
    return kv.get("PRETTY_NAME", "")


def write_status(status):
    """The local copy, atomically and world-readable: the console menu reads it as root, the probe
    container could read it through its data volume."""
    try:
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(status) + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS_FILE)
    except OSError:
        pass


def main():
    status = {
        "sec_updates": sec_updates(),
        "reboot_required": os.path.exists("/var/run/reboot-required"),
        "os": os_name(),
        "reported_at": int(time.time()),
    }
    write_status(status)
    env = read_kv(META)
    token, checkin = env.get("PROBE_TOKEN", ""), env.get("CHECKIN_URL", "")
    if not token or not checkin:
        return 0  # not enrolled yet - nothing to post
    url = checkin.rsplit("/", 1)[0] + "/os-status"  # .../api/probes/checkin -> .../api/probes/os-status
    body = json.dumps({k: status[k] for k in ("sec_updates", "reboot_required", "os")}).encode("utf-8")
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"Authorization": "Bearer " + token,
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20):
            pass
    except Exception:
        pass  # best-effort; the next hourly run retries
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
