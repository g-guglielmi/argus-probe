"""Report this probe VM's OS patch status to Argus (DESIGN 14c) and keep a copy for the console.

The VM patches its own Debian OS locally via unattended-upgrades (security suite only) and reboots
itself only when an update needs it, in the reboot window Argus hands it (argus-reboot-check). This
reporter only reports: it posts the pending security-update count and the reboot-required flag to
Argus, so the fleet view shows which sites carry CVEs or need a reboot, and writes the same as
os-status.json into the probe's data folder, where the console menu reads it. With them go what
Reboot now and Patch now need: that this VM's scripts take them, when it booted (a reboot Argus asked
for is done once the VM booted after it), and the last result of each. Run hourly by
argus-os-report.timer, a minute after boot, after the host tools were applied, after a Reboot now or
Patch now, and as soon as the probe enrolls (argus-os-report.path watches proxy.env), so the first
report doesn't wait an hour.

Standard library only. Authenticated by the same long-lived probe token the enrollment wrote to
proxy.env, so until the VM has enrolled there is nothing to post (the local file is still written).
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

STATE_DIR = os.environ.get("ARGUS_STATE_DIR", "/docker/argus-probe")
META = os.path.join(STATE_DIR, "enroll", "proxy.env")   # written by the probe container at enrollment
STATUS_FILE = os.path.join(STATE_DIR, "os-status.json")


def read_kv(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return out


def count_updates(out):
    """The updates the automatic patching applies, from a simulated upgrade's Inst lines: a *-security
    suite, and on a DietPi probe everything from the repositories its board's kernel and firmware come
    from: Raspberry Pi's on a Pi, DietPi's own (label "DietPi") on a NanoPi and wherever it is set up.
    Neither has a security suite, so the patching takes all of them."""
    n = 0
    for line in out.splitlines():
        if line.startswith("Inst") and re.search(r"[Ss]ecurity|Raspberry Pi|[ (]DietPi:", line):
            n += 1
    return n


def sec_updates():
    """Count pending SECURITY updates (best-effort; count_updates). -1 = unknown."""
    try:
        out = subprocess.run(
            ["apt-get", "-s", "-o", "Debug::NoLocking=true", "upgrade"],
            capture_output=True, text=True, timeout=90,
        ).stdout
    except Exception:
        return -1
    return count_updates(out)


def debian_name(release="/etc/os-release", debian="/etc/debian_version"):
    """Debian with its point release ("Debian 13.7", from DEBIAN_VERSION_FULL, or /etc/debian_version
    before Debian 13 added it), anything else by its PRETTY_NAME. "" if unreadable."""
    kv = {k: v.strip('"').strip("'") for k, v in read_kv(release).items()}
    if kv.get("ID") == "debian":
        v = kv.get("DEBIAN_VERSION_FULL", "")
        if not v:
            try:
                with open(debian, encoding="utf-8") as fh:
                    v = fh.read().strip()
            except OSError:
                pass
        if re.fullmatch(r"[0-9][0-9.]*", v):  # testing and sid read "forky/sid": those keep the pretty name
            return "Debian " + v
    return kv.get("PRETTY_NAME", "")


def dietpi_version(path="/boot/dietpi/.version"):
    """DietPi's own version ("10.8"), "" when this host is not DietPi."""
    kv = {k: v.strip('"').strip("'") for k, v in read_kv(path).items()}
    core, sub = kv.get("G_DIETPI_VERSION_CORE", ""), kv.get("G_DIETPI_VERSION_SUB", "")
    if re.fullmatch(r"[0-9]+", core) and re.fullmatch(r"[0-9]+", sub):
        return core + "." + sub
    return ""


def os_name(release="/etc/os-release", debian="/etc/debian_version", dietpi="/boot/dietpi/.version"):
    """The OS as Argus shows it: "Debian 13.7", or on a DietPi probe (a Raspberry Pi or a mini PC)
    "DietPi 10.8 (Debian 13.7)"."""
    base = debian_name(release, debian)
    dp = dietpi_version(dietpi)
    if dp:
        return "DietPi %s (%s)" % (dp, base) if base else "DietPi " + dp
    return base


def dietpi_update(path="/run/dietpi/.update_available"):
    """The DietPi release waiting to be applied ("10.9.0"), which DietPi's own daily check leaves in
    /run; "" when there is none (or the host is not DietPi). Patch now applies it."""
    try:
        with open(path, encoding="utf-8") as fh:
            v = fh.read().strip()
    except OSError:
        return ""
    return v if re.fullmatch(r"[0-9]+(\.[0-9]+){1,2}", v) else ""


def _kernel_flavour(release):
    """A kernel release split into its version and flavour: "6.12.48+deb13-amd64" -> ("6.12.48+deb13",
    "amd64"), "6.12.47+rpt-rpi-v8" -> ("6.12.47+rpt", "rpi-v8"), Debian 12's "6.1.0-25-amd64" ->
    ("6.1.0-25", "amd64"); None when it doesn't read like one."""
    m = re.fullmatch(r"([0-9][0-9.]*(?:-[0-9]+)?(?:[+~][A-Za-z0-9.~+]*)?)-([A-Za-z][A-Za-z0-9-]*)", release)
    return (m.group(1), m.group(2)) if m else None


def _version_key(v):
    return [int(x) for x in re.findall(r"[0-9]+", v)]


def reboot_reason(flag="/var/run/reboot-required", modules="/lib/modules", boot="/boot", running=None):
    """Why this host needs a reboot, "" when it doesn't. Any of: the reboot-required flag (written by the
    kernel postinst hook unattended-upgrades ships, and by needrestart and other packages); the running
    kernel's modules are gone (it was upgraded in place: DietPi's own test); a newer kernel of the
    running flavour is installed than the one running (a kernel package that doesn't set the flag)."""
    if os.path.exists(flag):
        return "an update asks for it"
    running = running or os.uname().release
    try:
        installed = os.listdir(modules)
    except OSError:
        installed = []
    if installed and running not in installed:
        return "the running kernel was removed"
    mine = _kernel_flavour(running)
    if mine:
        try:
            names = os.listdir(boot)
        except OSError:
            names = []
        for name in names:
            if not name.startswith("vmlinuz-"):
                continue
            other = _kernel_flavour(name[len("vmlinuz-"):])
            if other and other[1] == mine[1] and _version_key(other[0]) > _version_key(mine[0]):
                return "a newer kernel is installed"
    return ""


def lan(run=subprocess.run):
    """This VM's LAN address and gateway: the source address and next hop of its route to the
    internet (ip -j route get), {} when there is none. The probe container runs on Docker's bridge
    and sees only its own 172.17.x address, so the Probes page takes the VM's from here."""
    try:
        out = run(["ip", "-j", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True,
                  timeout=5, check=False).stdout
        r = json.loads(out)[0]
    except (OSError, ValueError, IndexError, KeyError, TypeError, subprocess.SubprocessError):
        return {}
    if not isinstance(r, dict) or not isinstance(r.get("prefsrc"), str) or not r["prefsrc"]:
        return {}
    gw = r.get("gateway")
    return {"ip": r["prefsrc"], "gw": gw if isinstance(gw, str) else ""}


def booted_at(stat="/proc/stat"):
    """When this VM booted (unix seconds), 0 if unreadable."""
    try:
        with open(stat, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("btime "):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return 0


def last_result(name):
    """The last result argus-reboot-check or argus-patch left (reboot-result.json, patch-result.json),
    or None."""
    try:
        with open(os.path.join(STATE_DIR, name), encoding="utf-8") as fh:
            r = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(r, dict) or not isinstance(r.get("state"), str) or not isinstance(r.get("at"), int):
        return None
    return {k: r[k] for k in ("state", "at", "why", "detail") if k in r}


def write_status(status):
    """The local copy, atomically and world-readable: the console menu reads it as root, the probe
    container could read it through its data volume."""
    try:
        tmp = STATUS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(status) + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, STATUS_FILE)
    except OSError:
        pass


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ["--reboot-needed"]:
        # argus-reboot-check asks: exit 0 (and why) when the host needs a reboot, 1 when it doesn't.
        why = reboot_reason()
        if why:
            print(why)
            return 0
        return 1
    why = reboot_reason()
    status = {
        "sec_updates": sec_updates(),
        "reboot_required": bool(why),
        "os": os_name(),
        "reported_at": int(time.time()),
        "reboot_now": True,
        "patch_now": True,
        "booted_at": booted_at(),
    }
    if why:
        status["reboot_why"] = why
    dp = dietpi_update()
    if dp:
        status["dietpi_update"] = dp
    for kind in ("reboot", "patch"):
        r = last_result(kind + "-result.json")
        if r:
            status[kind] = r
    addr = lan()
    if addr:
        status["lan"] = addr
    write_status(status)
    env = read_kv(META)
    token, checkin = env.get("PROBE_TOKEN", ""), env.get("CHECKIN_URL", "")
    if not token or not checkin:
        return 0  # not enrolled yet - nothing to post
    url = checkin.rsplit("/", 1)[0] + "/os-status"  # .../api/probes/checkin -> .../api/probes/os-status
    body = json.dumps({k: status[k] for k in ("sec_updates", "reboot_required", "os", "reboot_now", "patch_now",
                                              "booted_at", "reboot", "patch", "lan", "reboot_why",
                                              "dietpi_update") if k in status}).encode("utf-8")
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"Authorization": "Bearer " + token,
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20):
            pass
    except Exception:
        pass  # best-effort; the next hourly run retries
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
