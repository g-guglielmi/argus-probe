def detect_role():
    forced = os.environ.get("ARGUS_CONSOLE_ROLE", "")
    if forced in ("core", "probe"):
        return forced
    if os.path.exists(PROBE_META) and not os.path.exists(CORE_SIGN):
        return "probe"
    return "core"


