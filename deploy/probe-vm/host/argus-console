HOSTS_FILE = ROOT + "/etc/hosts"
VCONSOLE_FILE = ROOT + "/etc/vconsole.conf"
RESOLV_FILES = (ROOT + "/run/systemd/resolve/resolv.conf", ROOT + "/etc/resolv.conf")
