DISK_RE = re.compile(r"^(/dev/(?:sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme\d+n\d+|mmcblk\d+))(?:p?)(\d+)$")


def split_partition(dev):
    """/dev/sda1 -> (/dev/sda, 1); /dev/nvme0n1p2 -> (/dev/nvme0n1, 2)."""
    m = DISK_RE.match(dev)
    if not m:
        return None, None
    return m.group(1), int(m.group(2))


def grow_disk():
    say("Grow the disk", "head")
    src = out(["findmnt", "-n", "-o", "SOURCE", "/"])
    fstype = out(["findmnt", "-n", "-o", "FSTYPE", "/"])
    disk, part = split_partition(src)
    if not disk:
        say("  The root file system is on %s, which this menu doesn't know how to grow." % (src or "an unknown device"), "err")
        return
    before = shutil.disk_usage("/").total
    print("  Root file system: %s (%s), %s. Enlarge the virtual disk in the hypervisor first;" % (src, fstype or "?", human(before)))
    print("  this extends partition %d of %s to the end of the disk and then the file system." % (part, disk))
    if ask("Go ahead? (yes/no)", "no").lower() != "yes":
        return
    rc, so, err = run(["growpart", disk, str(part)], timeout=120)
    if rc == 127:
        say("  growpart is not installed (package cloud-guest-utils).", "err")
        return
    if rc == 1 and "NOCHANGE" in (so + err):
        say("  The partition already fills the disk. Enlarge the virtual disk in the hypervisor, then try again.", "warn")
        return
    if rc not in (0,):
        say("  growpart failed: %s" % (err or so).strip(), "err")
        return
    if fstype == "xfs":
        rc, _, err = run(["xfs_growfs", "/"], timeout=120)
    else:
        rc, _, err = run(["resize2fs", src], timeout=300)
    if rc != 0:
        say("  The partition grew but the file system did not: %s" % err.strip(), "err")
        return
    after = shutil.disk_usage("/").total
    log("root disk grown %s -> %s" % (human(before), human(after)))
    say("  Done: %s -> %s." % (human(before), human(after)), "ok")


