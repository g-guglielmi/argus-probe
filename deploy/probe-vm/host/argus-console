def check_url(u):
    u = u.strip()
    p = urllib.parse.urlsplit(u)
    if p.scheme not in ("https", "http") or not p.hostname or not p.path.endswith("/checkin") or p.query or p.fragment:
        raise ValueError("the check-in URL looks like https://monitoring.example.com/api/probes/checkin")
    if re.search(r"[^A-Za-z0-9.:/_%-]", u):
        raise ValueError("unexpected characters in the URL")
    return u


