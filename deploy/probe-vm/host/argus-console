# ------------------------------------------------------------------ commands

def run(cmd, input_text=None, timeout=120):
    """Run a command without a shell; (returncode, stdout, stderr), never an exception for a missing
    program or a timeout (those read as a failure with its reason in stderr)."""
    try:
        p = subprocess.run(cmd, input=input_text, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return 127, "", "%s is not installed" % cmd[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s did not finish within %d s" % (os.path.basename(cmd[0]), timeout)
    return p.returncode, p.stdout, p.stderr


def out(cmd, timeout=30):
    rc, so, _ = run(cmd, timeout=timeout)
    return so.strip() if rc == 0 else ""


def interactive(cmd, env=None, preexec=None):
    """Run a command on the operator's terminal (its own input and output), returning its exit code."""
    try:
        return subprocess.run(cmd, env=env, preexec_fn=preexec).returncode
    except FileNotFoundError:
        say("%s is not installed on this host." % cmd[0], "err")
        return 127
    except KeyboardInterrupt:
        return 130


def log(msg):
    run(["logger", "-t", "argus-console", msg], timeout=5)


def read_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def write_file(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, mode)
    if os.name == "nt" and os.path.exists(path):
        os.chmod(path, 0o644)  # the tests run on Windows too, where a read-only file can't be replaced
    os.replace(tmp, path)


def remove_file(path):
    """Remove a file that may be read-only (the sudoers drop-in); fine if it is already gone."""
    try:
        if os.name == "nt" and os.path.exists(path):
            os.chmod(path, 0o644)
        os.remove(path)
    except OSError:
        pass


# ------------------------------------------------------------------ terminal

COLORS = {"ok": "\x1b[32m", "warn": "\x1b[33m", "err": "\x1b[31m", "head": "\x1b[1m", "dim": "\x1b[2m", "brand": "\x1b[36m"}


def tty():
    return sys.stdout.isatty()


def paint(text, tone):
    if not tty() or tone not in COLORS:
        return text
    return COLORS[tone] + text + "\x1b[0m"


def say(text, tone=None):
    print(paint(text, tone) if tone else text)


def clear():
    if tty():
        sys.stdout.write("\x1b[2J\x1b[H")
        sys.stdout.flush()


def ask(prompt, default=None):
    """One line of input; Enter alone gives the default. Ctrl-D reads as an empty answer."""
    label = "%s [%s]: " % (prompt, default) if default not in (None, "") else prompt + ": "
    try:
        answer = input(paint(label, "head")).strip()
    except EOFError:
        print()
        answer = ""
    return answer if answer else (default or "")


def ask_valid(prompt, check, default=None, blank_ok=False):
    """Ask until `check` accepts the answer; check returns the value or raises ValueError with the
    reason. A blank answer with blank_ok returns None."""
    while True:
        a = ask(prompt, default)
        if a == "" and blank_ok:
            return None
        try:
            return check(a)
        except ValueError as e:
            say("  %s" % e, "err")


def pause():
    try:
        input(paint("\nPress Enter to go back to the menu", "dim"))
    except EOFError:
        pass


def wait_enter(seconds):
    """True if Enter arrives within `seconds` (a remote session that survived the network change)."""
    try:
        ready, _, _ = select.select([sys.stdin], [], [], seconds)
    except (OSError, ValueError):
        return False
    if ready:
        try:
            sys.stdin.readline()
        except OSError:
            pass
        return True
    return False


def page(text, lines=40):
    """Show long output a screen at a time."""
    rows = text.rstrip("\n").split("\n")
    for i in range(0, len(rows), lines):
        print("\n".join(rows[i:i + lines]))
        if i + lines < len(rows):
            try:
                more = input(paint("-- more (Enter) or q --", "dim")).strip().lower()
            except EOFError:
                return
            if more == "q":
                return


def is_remote():
    """A pseudo-terminal means SSH; the VM's own console is a tty or a serial line."""
    try:
        name = os.ttyname(sys.stdin.fileno())
    except OSError:
        return False
    return "/pts/" in name


# ------------------------------------------------------------------ status

def uptime_text():
    try:
        secs = float(read_file(ROOT + "/proc/uptime").split()[0])
    except (ValueError, IndexError):
        return ""
    days, rest = divmod(int(secs), 86400)
    hours, rest = divmod(rest, 3600)
    mins = rest // 60
    if days:
        return "up %dd %dh" % (days, hours)
    if hours:
        return "up %dh %dm" % (hours, mins)
    return "up %dm" % mins


def primary_link():
    """(interface, gateway) of the default route, or the first wired link without one."""
    try:
        routes = json.loads(out(["ip", "-j", "route", "show", "default"]) or "[]")
    except ValueError:
        routes = []
    for r in routes:
        if r.get("dev"):
            return r["dev"], r.get("gateway", "")
    try:
        links = json.loads(out(["ip", "-j", "link", "show"]) or "[]")
    except ValueError:
        links = []
    for l in links:
        n = l.get("ifname", "")
        if n.startswith(("en", "eth")):
            return n, ""
    return "", ""


def link_addresses(dev):
    try:
        info = json.loads(out(["ip", "-j", "-4", "addr", "show", "dev", dev]) or "[]")
    except ValueError:
        info = []
    addrs = []
    for l in info:
        for a in l.get("addr_info", []):
            if a.get("family") == "inet" and a.get("scope") == "global":
                addrs.append("%s/%s" % (a.get("local"), a.get("prefixlen")))
    return addrs


def dns_servers():
    for path in RESOLV_FILES:
        text = read_file(path)
        if text:
            return [l.split()[1] for l in text.splitlines() if l.startswith("nameserver") and len(l.split()) > 1]
    return []


def net_mode():
    return "static" if os.path.exists(STATIC_FILE) else "DHCP"


def web_addresses(ip):
    """The https address that always works, plus the name on the appliance's own certificate."""
    urls = ["https://%s/" % ip] if ip else []
    if os.path.exists(WEB_CERT):
        subj = out(["openssl", "x509", "-in", WEB_CERT, "-noout", "-subject"])
        m = re.search(r"CN\s*=\s*([A-Za-z0-9.-]+)", subj)
        if m and m.group(1) != ip:
            urls.append("https://%s/" % m.group(1))
    return urls


def os_status():
    try:
        return json.loads(read_file(os.path.join(STATE_DIR, "os-status.json")) or "{}")
    except ValueError:
        return {}


def disk_text(path):
    try:
        u = shutil.disk_usage(path)
    except OSError:
        return ""
    return "%s %d%% of %s" % (path, round(100.0 * u.used / u.total) if u.total else 0, human(u.total))


def same_fs(a, b):
    try:
        return os.stat(a).st_dev == os.stat(b).st_dev
    except OSError:
        return False


DOCKER_DIR = "/docker"


def disk_lines():
    """The root file system, and /docker when it is a file system of its own (on the appliance it
    is a folder of the root one, so one line says both)."""
    root = disk_text("/")
    if not root:
        return [d for d in (disk_text(DOCKER_DIR),) if d]
    if os.path.isdir(DOCKER_DIR) and same_fs("/", DOCKER_DIR):
        return [root + " (holds /docker)"]
    return [d for d in (root, disk_text(DOCKER_DIR)) if d]


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%d %s" % (round(n), unit) if unit in ("B", "KB", "MB") else "%.0f %s" % (n, unit)
        n /= 1024.0
    return "%d" % n


def unit_state(unit):
    return out(["systemctl", "is-active", unit]) or "inactive"


INSPECT_FMT = "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.Image}}"
# The updater stamps its own label; the core's build writes the OCI one from git describe.
VERSION_LABELS = ("io.argus.updater.version", "org.opencontainers.image.version")
IMAGE_FMT = "|".join('{{index .Config.Labels "%s"}}' % l for l in VERSION_LABELS)


def container_state(name):
    """(state, version): 'healthy' / 'running' / 'exited' / 'missing', and the version of the image it runs."""
    rc, so, _ = run(["docker", "inspect", "-f", INSPECT_FMT, name], timeout=20)
    if rc != 0:
        return "missing", ""
    parts = (so.strip().split("|") + ["", "", ""])[:3]
    state = parts[1] or parts[0] or "unknown"
    return state, image_version(parts[2])


def image_version(image):
    """The version label of the image itself. A container's own labels are a copy taken when it was
    first created, and the updater's recreate clones that config, so they still say what the first
    image said long after every update; the image's labels move with the image."""
    if not image:
        return ""
    rc, so, _ = run(["docker", "inspect", "-f", IMAGE_FMT, image], timeout=20)
    if rc != 0:
        return ""
    for v in so.strip().split("|"):
        if v and v != "<no value>":
            return v
    return ""


def status():
    dev, gw = primary_link()
    addrs = link_addresses(dev) if dev else []
    ip = addrs[0].split("/")[0] if addrs else ""
    st = {
        "hostname": socket.gethostname(), "uptime": uptime_text(), "dev": dev, "gateway": gw, "addrs": addrs, "ip": ip,
        "mode": net_mode(), "dns": dns_servers(), "web": web_addresses(ip),
        "ntp": out(["timedatectl", "show", "-p", "NTPSynchronized", "--value"]) == "yes",
        "tz": out(["timedatectl", "show", "-p", "Timezone", "--value"]),
        "disks": disk_lines(), "os": os_status(), "tools": host_tools_status(),
        "units": [(label, unit_state(u)) for label, u in UNITS],
        "containers": [(label, ) + container_state(c) for label, c in CONTAINERS],
    }
    if ROLE == "probe":
        meta = read_kv(PROBE_META)
        env = read_kv(PROBE_ENV)
        st["site"] = meta.get("PROXY_NAME", "")
        st["core"] = env.get("ZBX_SERVER_HOST") or meta.get("CORE_HOST", "")
        st["checkin"] = meta.get("CHECKIN_URL", "")
    return st


def read_kv(path):
    """KEY=value lines (proxy.env, probe.env, os-release); comments and blanks skipped."""
    out = {}
    for line in read_file(path).splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def write_kv(path, updates, mode=0o600):
    """Set keys in a KEY=value file, keeping every other line as it is (a missing key is appended)."""
    lines = read_file(path).splitlines()
    done = set()
    for i, line in enumerate(lines):
        k = line.split("=", 1)[0].strip() if "=" in line and not line.lstrip().startswith("#") else None
        if k in updates:
            lines[i] = "%s=%s" % (k, updates[k])
            done.add(k)
    for k, v in updates.items():
        if k not in done:
            lines.append("%s=%s" % (k, v))
    write_file(path, "\n".join(lines) + "\n", mode)


def host_tools_status():
    """What the updater last did with this host's scripts and units (host-tools.json), if anything."""
    try:
        return json.loads(read_file(os.path.join(STATE_DIR, "host-tools.json")) or "{}")
    except ValueError:
        return {}


def tone_for(state):
    if state in ("active", "healthy", "running"):
        return "ok"
    if state in ("starting", "activating", "unhealthy"):
        return "warn"
    return "err"


def render_status(st):
    for l in BANNER.split("\n"):
        say("  " + l, "brand")
    print()
    who = "%s   %s" % (st["hostname"], st["uptime"])
    what = "  Monitoring cockpit, " + ("probe" + (" " + st["site"] if st.get("site") else "") if ROLE == "probe" else "core")
    say(what.ljust(WIDTH - 2 - len(who)) + who, "head")
    print()
    addr = ", ".join(st["addrs"]) or "no address"
    if st["gateway"]:
        addr += " via " + st["gateway"]
    addr += " (%s)" % st["mode"]
    if st["dev"]:
        addr += " on " + st["dev"]
    line("Address", addr)
    line("DNS", ", ".join(st["dns"]) or "none")
    if ROLE == "probe":
        core = st.get("core") or "not enrolled yet"
        if st.get("checkin"):
            core += "   check-in " + (urllib.parse.urlsplit(st["checkin"]).netloc or st["checkin"])
        line("Core", core)
    elif st["web"]:
        line("Web", "   also ".join(st["web"]))
    line("Time", (paint("synced (NTP)", "ok") if st["ntp"] else paint("not synced", "warn")) + ("  " + st["tz"] if st["tz"] else ""))
    if st["disks"]:
        line("Disk", "   ".join(st["disks"]))
    o = st["os"]
    if o:
        n = int(o.get("sec_updates") or 0)
        os_text = "%d security update%s" % (n, "" if n == 1 else "s") if n else "up to date"
        if o.get("reboot_required"):
            os_text += ", " + paint("reboot pending", "warn")
        if o.get("zbx_candidate") and o.get("zbx_candidate") != o.get("zbx_server"):
            os_text += ", Zabbix %s available" % o["zbx_candidate"]
        line("OS", os_text)
    t = st["tools"]
    if t.get("state"):
        text = paint(t["state"], tone_for({"ok": "active", "skipped": "starting"}.get(t["state"], "failed")))
        if t.get("version"):
            text += "  " + t["version"]
        if t.get("message"):
            text += "  " + t["message"]
        line("Tools", text)
    print()
    line("Services", "   ".join("%s %s" % (label, paint(state, tone_for(state))) for label, state in st["units"]))
    cs = []
    for label, state, version in st["containers"]:
        cs.append("%s%s %s" % (label, " " + version if version else "", paint(state, tone_for(state))))
    line("", "   ".join(cs))
    print()


def line(key, value):
    print("  %-11s %s" % (key, value))


# ------------------------------------------------------------------ validation

def check_cidr(a):
    try:
        iface = ipaddress.ip_interface(a)
    except ValueError:
        raise ValueError("write the address with its prefix length, like 10.0.0.10/24")
    if "/" not in a:
        raise ValueError("write the address with its prefix length, like 10.0.0.10/24")
    if iface.network.prefixlen == iface.max_prefixlen:
        raise ValueError("a /%d leaves no room for a gateway; use the network's prefix (like /24)" % iface.max_prefixlen)
    return iface


def check_gateway_for(iface):
    def check(g):
        try:
            gw = ipaddress.ip_address(g)
        except ValueError:
            raise ValueError("not an address")
        if gw.version != iface.ip.version:
            raise ValueError("the gateway must be an IPv%d address like the interface" % iface.ip.version)
        if gw not in iface.network:
            raise ValueError("%s is outside %s" % (gw, iface.network))
        if gw == iface.ip:
            raise ValueError("the gateway is another device, not this one")
        return gw
    return check


def check_dns(s):
    servers = []
    for tok in re.split(r"[,\s]+", s.strip()):
        if not tok:
            continue
        try:
            servers.append(ipaddress.ip_address(tok))
        except ValueError:
            raise ValueError("%s is not an address" % tok)
    if not servers:
        raise ValueError("at least one DNS server")
    if len(servers) > 3:
        raise ValueError("at most three DNS servers")
    return servers


HOSTNAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$")


def check_hostname(h):
    h = h.strip().lower()
    if not h or len(h) > 253 or not HOSTNAME_RE.match(h):
        raise ValueError("letters, digits and hyphens, labels joined by dots (like zbx-core or zbx-core.example.lan)")
    return h


def check_domain(d):
    return check_hostname(d)


def check_keymap(k):
    k = k.strip().lower()
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,15}", k):
        raise ValueError("a layout name like it, de, us, fr or en-latin9")
    return k


# ------------------------------------------------------------------ networking

def render_static(dev, iface, gw, dns, domain):
    lines = ["# Written by argus-console: a static address for the primary NIC. Delete this file (or pick DHCP",
             "# in the console menu) to go back to the DHCP of 10-argus-dhcp.network.",
             "[Match]", "Name=%s" % dev, "", "[Network]", "Address=%s" % iface.with_prefixlen, "Gateway=%s" % gw]
    lines += ["DNS=%s" % s for s in dns]
    if domain:
        lines.append("Domains=%s" % domain)
    return "\n".join(lines) + "\n"


def apply_network(dev):
    """Tell networkd about the files; the reconfigure drops and re-sets the link's addresses."""
    rc, _, err = run(["networkctl", "reload"], timeout=30)
    if rc == 127:
        rc, _, err = run(["systemctl", "restart", "systemd-networkd"], timeout=60)
        return rc == 0, err
    if rc != 0:
        return False, err
    if dev:
        rc, _, err = run(["networkctl", "reconfigure", dev], timeout=30)
        return rc == 0, err
    return True, ""


def save_network_backup():
    before = read_file(STATIC_FILE) if os.path.exists(STATIC_FILE) else None
    write_file(REVERT_BACKUP, json.dumps({"static": before, "at": int(time.time())}), 0o600)


def restore_network_backup():
    """Put the files back as they were before the change and re-apply them."""
    try:
        bk = json.loads(read_file(REVERT_BACKUP) or "{}")
    except ValueError:
        bk = {}
    if "static" not in bk:
        return False
    if bk["static"] is None:
        if os.path.exists(STATIC_FILE):
            os.remove(STATIC_FILE)
    else:
        write_file(STATIC_FILE, bk["static"])
    os.remove(REVERT_BACKUP)
    dev, _ = primary_link()
    return apply_network(dev)[0]


def schedule_revert():
    run(["systemctl", "stop", REVERT_UNIT + ".timer"], timeout=20)
    rc, _, err = run(["systemd-run", "--unit=" + REVERT_UNIT, "--on-active=%d" % REVERT_AFTER, "--quiet",
                      SELF, "--revert-network"], timeout=20)
    return rc == 0, err


def cancel_revert(reason):
    """A revert is pending: stop its timer and keep the change (the operator reached the VM on it)."""
    if not os.path.exists(REVERT_BACKUP):
        return False
    run(["systemctl", "stop", REVERT_UNIT + ".timer"], timeout=20)
    try:
        os.remove(REVERT_BACKUP)
    except OSError:
        pass
    log("network change kept: " + reason)
    return True


def configure_network():
    dev, _ = primary_link()
    st_mode = net_mode()
    say("Configure networking", "head")
    print("  Interface %s, now %s." % (dev or "unknown", st_mode))
    print("  1) DHCP (the address, gateway and DNS from the network's DHCP server)")
    print("  2) Static address")
    choice = ask("Choose", "1" if st_mode == "DHCP" else "2")
    if choice not in ("1", "2"):
        return
    if choice == "1":
        if not os.path.exists(STATIC_FILE):
            say("  Already DHCP; nothing to change.", "dim")
            return
        save_network_backup()
        os.remove(STATIC_FILE)
        summary = "DHCP on %s" % dev
    else:
        if not dev:
            say("  No network interface found.", "err")
            return
        current = link_addresses(dev)
        iface = ask_valid("Address with prefix (like 10.0.0.10/24)", check_cidr, current[0] if current else None)
        _, gw_now = primary_link()
        gw = ask_valid("Gateway", check_gateway_for(iface), gw_now or None)
        dns = ask_valid("DNS servers (one to three, separated by spaces)", check_dns, " ".join(dns_servers()) or None)
        domain = ask_valid("Search domain (Enter for none)", check_domain, blank_ok=True)
        text = render_static(dev, iface, gw, dns, domain)
        print()
        print("  " + text.replace("\n", "\n  ").rstrip())
        if ask("Apply this? (yes/no)", "no").lower() != "yes":
            return
        save_network_backup()
        write_file(STATIC_FILE, text)
        summary = "static %s via %s on %s, DNS %s" % (iface.with_prefixlen, gw, dev, " ".join(str(s) for s in dns))
    remote = is_remote()
    if remote:
        ok, err = schedule_revert()
        if not ok:
            say("  Could not arm the safety revert (%s); applying anyway." % err.strip(), "warn")
    ok, err = apply_network(dev)
    if not ok:
        say("  networkd did not take the change: %s" % err.strip(), "err")
        restore_network_backup()
        run(["systemctl", "stop", REVERT_UNIT + ".timer"], timeout=20)
        return
    log("network changed to " + summary)
    if not remote:
        try:
            os.remove(REVERT_BACKUP)
        except OSError:
            pass
        say("  Applied: %s" % summary, "ok")
        return
    say("  Applied: %s" % summary, "ok")
    print("  You are connected over SSH. If this session survives, press Enter within %d s to keep the" % REVERT_AFTER)
    print("  change. If it drops, log in again on the new address within %d s; that keeps it too." % REVERT_AFTER)
    print("  With neither, the previous configuration comes back by itself.")
    if wait_enter(REVERT_AFTER - 10):
        cancel_revert("confirmed in the session")
        say("  Kept.", "ok")
    else:
        say("  No answer: the change reverts in a moment unless a new login arrived.", "warn")


def revert_network_main():
    """Run by the timer: nobody confirmed the change or reached the VM on it."""
    if not os.path.exists(REVERT_BACKUP):
        return 0
    ok = restore_network_backup()
    log("network change reverted: no login within %d s" % REVERT_AFTER if ok else "network revert failed")
    return 0 if ok else 1


