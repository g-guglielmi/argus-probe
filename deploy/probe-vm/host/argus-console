SELF = "/usr/local/sbin/argus-console"
LOGIN_SHELL = SELF + "-login"
SHELLS_FILE = ROOT + "/etc/shells"
SUDOERS_FILE = ROOT + "/etc/sudoers.d/argus-console"
OS_REPORT = "/usr/local/sbin/argus-os-report"

