def user_exists(user):
    import pwd  # Unix only
    try:
        pwd.getpwnam(user)
        return True
    except KeyError:
        return False


def make_login_shell(user, remove=False):
    """Make the menu what a login of `user` opens: the wrapper as the login shell (listed in
    /etc/shells) and a sudoers drop-in that lets the account run the menu, and only the menu, without
    a second password, kept only if visudo accepts it. The appliance's first boot does this for the
    Debian user; `sudo argus-console --make-login-shell` does it for whoever runs it on any core.
    --remove-login-shell puts bash back and drops the sudoers file."""
    if not user or user == "root":
        say("Say which account: argus-console --make-login-shell <user> (root keeps its shell).", "err")
        return 1
    if not user_exists(user):
        say("There is no user %s on this host." % user, "err")
        return 1
    if remove:
        rc, _, err = run(["usermod", "-s", "/bin/bash", user], timeout=20)
        if rc != 0:
            say("usermod refused: %s" % err.strip(), "err")
            return 1
        remove_file(SUDOERS_FILE)
        log("console menu removed as the login shell of " + user)
        say("Logins of %s open bash again; the menu stays available as sudo argus-console." % user, "ok")
        return 0
    if LOGIN_SHELL not in read_file(SHELLS_FILE).split():
        with open(SHELLS_FILE, "a", encoding="utf-8") as fh:
            fh.write(LOGIN_SHELL + "\n")
    write_file(SUDOERS_FILE, "# Written by argus-console: the console menu without a second password for its login account.\n"
               "%s ALL=(root) NOPASSWD: %s\n" % (user, SELF), 0o440)
    rc, _, _ = run(["visudo", "-cf", SUDOERS_FILE], timeout=20)
    if rc != 0:
        remove_file(SUDOERS_FILE)  # never leave sudo a file it can't parse; the menu then asks the password
        say("visudo did not accept the sudoers line; the menu will ask the password at login.", "warn")
    rc, _, err = run(["usermod", "-s", LOGIN_SHELL, user], timeout=20)
    if rc != 0:
        say("usermod refused: %s" % err.strip(), "err")
        return 1
    log("console menu is now the login shell of " + user)
    say("Logins of %s (console and SSH) now open the menu; Open a shell gives bash, and ssh commands" % user, "ok")
    say("and scp still work. Undo with: sudo argus-console --remove-login-shell %s" % user, "ok")
    return 0


