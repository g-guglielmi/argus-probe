            ("6", "Restart Zabbix server", "restart-zabbix"),
            ("7", "View logs", "logs"),
        )),
        ("Maintenance", (
            ("8", "Install OS updates now", "updates"),
            ("9", "Grow the disk (after enlarging the virtual disk)", "grow"),
            ("10", "Keyboard layout and time zone", "keyboard"),
            ("11", "Change the console password", "password"),
            ("12", "!! Reboot the VM !!", "reboot"),
            ("13", "!! Power off the VM !!", "poweroff"),
        )),
        ("Other", (
            ("14", "Open a shell", "shell"),
            ("15", "Log out", "logout"),
        )),
    )


def render_menu():
    for group, items in MENU:
        say("  " + group, "head")
        for key, label, action in items:
            text = "%3s) %s" % (key, label)
            print(paint(text, "err") if action in ("reboot", "poweroff") else text)
    print()


def dispatch(action, user):
    if action == "network":
        configure_network()
    elif action == "hostname":
        change_hostname()
    elif action == "connectivity":
        test_connectivity()
    elif action == "restart-argus":
        restart("Argus", container="argus")
    elif action == "restart-probe":
        restart("the probe", container="argus-probe")
    elif action == "restart-updater":
        restart("the updater", container="argus-updater")
    elif action == "restart-zabbix":
        restart("Zabbix server", unit="zabbix-server")
    elif action == "checkin":
        checkin_now()
    elif action == "core":
        change_core()
    elif action == "logs":
        view_logs()
    elif action == "updates":
        install_updates()
    elif action == "grow":
        grow_disk()
    elif action == "keyboard":
        keyboard_and_timezone()
    elif action == "password":
        change_password(user)
    elif action in ("reboot", "poweroff"):
        power(action)
    elif action == "shell":
        open_shell(user)
        return False
    elif action == "logout":
        return None
    return True


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if "--revert-network" in argv:
        return revert_network_main()
    if "--status" in argv:
        render_status(status())
        return 0
    if os.geteuid() != 0:
        print("argus-console runs as root: sudo argus-console", file=sys.stderr)
        return 1
    user = os.environ.get("SUDO_USER") or ""
    for flag in ("--make-login-shell", "--remove-login-shell"):
        if flag in argv:
            i = argv.index(flag)
            named = argv[i + 1] if i + 1 < len(argv) and not argv[i + 1].startswith("--") else user
            return make_login_shell(named, remove=flag == "--remove-login-shell")
    if cancel_revert("a login reached the VM on the new address"):
        print(paint("The network change made a moment ago is kept: this login reached the VM on it.", "ok"))
        pause()
    while True:
        clear()
        try:
            render_status(status())
        except Exception as e:  # the status is a courtesy; the menu must come up regardless
            say("  (status unavailable: %s)" % e, "warn")
            print()
        render_menu()
        try:
            choice = ask("Choose", "")
        except KeyboardInterrupt:
            print()
            continue
        if choice == "":
            continue
        action = None
        for _, items in MENU:
            for key, _, a in items:
                if key == choice:
                    action = a
        if action is None:
            continue
        print()
        try:
            res = dispatch(action, user)
        except KeyboardInterrupt:
            print()
            res = True
        if res is None:
            return 0
        if res:
            pause()


if __name__ == "__main__":
    sys.exit(main())
