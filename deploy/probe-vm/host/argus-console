def open_shell(user):
    """A normal bash as the console account (sudo stays available, every use logged); back here on exit."""
    print("  Type exit to come back to the menu.")
    pw = None
    if user and user != "root":
        import pwd  # Unix only; the tests run the rest of this file elsewhere too
        try:
            pw = pwd.getpwnam(user)
        except KeyError:
            pw = None
    if pw is None:
        interactive(["/bin/bash", "-l"])
        return

    def demote():
        os.initgroups(pw.pw_name, pw.pw_gid)
        os.setgid(pw.pw_gid)
        os.setuid(pw.pw_uid)
        os.chdir(pw.pw_dir if os.path.isdir(pw.pw_dir) else "/")

    env = {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name, "SHELL": "/bin/bash",
           "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "TERM": os.environ.get("TERM", "linux"),
           "LANG": os.environ.get("LANG", "C.UTF-8")}
    interactive(["/bin/bash", "-l"], env=env, preexec=demote)


