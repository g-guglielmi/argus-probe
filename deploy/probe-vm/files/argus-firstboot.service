[Unit]
Description=Argus probe first-boot enrollment (seed disk / setup page) + break-glass credential
Documentation=https://github.com/g-guglielmi/argus
# Drives enrollment: adopt an attached seed disk if present, else serve a setup page; set the console
# keyboard layout; and once enrolled, generate + report the break-glass credential. No-ops on a boot
# where the probe is already enrolled and that credential has been reported.
Wants=network-online.target
After=network-online.target
Requires=docker.service

[Service]
# Long-running: it serves the setup + live status page until the probe enrols, then disables itself
# (so it never runs again) and exits. On a boot where the probe is already enrolled it exits at once.
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/argus-firstboot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
