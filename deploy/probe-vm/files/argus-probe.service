[Unit]
Description=Argus probe (self-enrolling Zabbix active proxy)
Documentation=https://github.com/g-guglielmi/argus
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
# Enrollment inputs live in this env file, written by cloud-init (Add-probe "VM" output) or by the
# first-boot setup page: ARGUS_ENROLL_URL, ARGUS_ENROLL_TOKEN, and optionally ZBX_SERVER_HOST.
# The image ships this unit installed but NOT enabled; enrollment enables it once the token is present,
# so an un-enrolled VM never crash-loops. ARGUS_PROBE_TAG defaults to latest unless the env file pins it.
# Defaults first, then the env file, so probe.env can override ARGUS_PROBE_TAG (later wins in systemd).
Environment=ARGUS_PROBE_TAG=latest
Environment=ARGUS_PROBE_IMAGE=ghcr.io/g-guglielmi/argus-probe
EnvironmentFile=/etc/argus-probe/probe.env
TimeoutStartSec=0
Restart=always
RestartSec=10

# Pull the target image, then run the stock probe in the foreground under systemd. The container
# self-enrolls on first boot (key + CSR generated locally, single-use token redeemed) and persists its
# certs to /var/lib/argus-probe, so a reboot skips enrollment.
ExecStartPre=-/usr/bin/docker rm -f argus-probe
ExecStartPre=/usr/bin/docker pull ${ARGUS_PROBE_IMAGE}:${ARGUS_PROBE_TAG}
ExecStart=/usr/bin/docker run --rm --name argus-probe \
  -v /var/lib/argus-probe:/var/lib/zabbix \
  -v /var/lib/argus-probe/snmptraps:/var/lib/zabbix/snmptraps \
  --env-file /etc/argus-probe/probe.env \
  ${ARGUS_PROBE_IMAGE}:${ARGUS_PROBE_TAG}
ExecStop=/usr/bin/docker stop argus-probe

[Install]
WantedBy=multi-user.target
