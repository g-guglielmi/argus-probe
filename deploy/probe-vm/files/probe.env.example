# /etc/argus-probe/probe.env - enrollment inputs for the probe container.
#
# On a deployed VM this file is written by cloud-init (the Add-probe "VM" output) or by the first-boot
# setup page - you don't normally edit it by hand. Kept here as a reference for the contract.
#
# Required:
ARGUS_ENROLL_URL=https://monitoring.example.com/api/enroll
ARGUS_ENROLL_TOKEN=paste-the-single-use-token-here
#
# Optional - only if the Argus server didn't bake a core host into the enrollment response
# (the address the probe dials for the Zabbix server on :10051):
#ZBX_SERVER_HOST=10.0.0.10
#
# Optional - pin the probe image tag (defaults to latest):
#ARGUS_PROBE_TAG=latest
