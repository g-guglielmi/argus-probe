# /etc/argus-probe/probe.env - enrollment inputs for the probe container.
#
# On a deployed VM this file is written by the first-boot service - from an attached seed disk
# (the Add-probe "VM" -> Download seed ISO output) or the first-boot setup page - so you don't
# normally edit it by hand. Kept here as a reference for the contract; the seed disk's ARGUS.ENV
# uses the same KEY=VALUE format.
#
# Required:
ARGUS_ENROLL_URL=https://monitoring.example.com/api/enroll
ARGUS_ENROLL_TOKEN=paste-the-single-use-token-here
#
# Optional - only if the Argus server didn't bake a core host into the enrollment response
# (the address the probe dials for the Zabbix server on :10051):
#ZBX_SERVER_HOST=10.0.0.10
#
# Optional - console keyboard layout, applied to /etc/vconsole.conf on first boot (default us). Only
# read from the seed disk / setup page - it's not used by the container:
#ARGUS_KEYMAP=it
#
# Optional - static networking for sites with NO DHCP (seed disk only; the VM DHCPs if these are
# absent). ARGUS_IP is the address in CIDR form; DNS may list several, comma separated:
#ARGUS_IP=10.0.0.50/24
#ARGUS_GATEWAY=10.0.0.1
#ARGUS_DNS=10.0.0.10
#
# Optional - pin the probe image tag (defaults to latest):
#ARGUS_PROBE_TAG=latest
